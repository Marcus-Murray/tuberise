    "email-sender": {
      "command": "node",
      "args": ["mcp-servers/email-sender-mcp.js"],
      "env": {
        "NODE_ENV": "development"
      }
    },
    "progress-tracker": {
      "command": "node",
      "args": ["mcp-servers/progress-tracker-mcp.js"],
      "env": {
